{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "Node16",
    "noEmit": true,
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "headless-spreadjs": ["src/index.ts"]
    }
  },
  "include": ["./**/*.ts", "../src/**/*.ts"]
}
